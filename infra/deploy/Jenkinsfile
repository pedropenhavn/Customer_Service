pipeline {
    agent any
    stages {
        stage('Code') {
            steps {
                echo "Cloning the code"
                git credentialsId: 'user-git', branch: 'main', url: 'https://github.com/pedropenhavn/Customer_Service'
            }
        }
        stage('Copy Env File') {
            steps {
                script {
                    withCredentials([file(credentialsId: 'customer-service.env', variable: 'ENV_FILE')]) {
                        sh '''
                            cp $ENV_FILE $WORKSPACE/.env
                            chmod 644 $WORKSPACE/.env
                            chown jenkins:jenkins $WORKSPACE/.env
                        '''
                    }
                }
            }
        }
        stage('Generate APP Key') {
            steps {
                script {
                    sh '''
                        # Verifica se APP_KEY já existe no .env
                        if ! grep -q "^APP_KEY=" $WORKSPACE/.env; then
                            echo "APP_KEY não encontrada, gerando nova chave..."
                            # Gera uma chave base64 de 32 bytes
                            NEW_KEY="base64:$(openssl rand -base64 32)"
                            echo "APP_KEY=$NEW_KEY" >> $WORKSPACE/.env
                            echo "APP_KEY gerada com sucesso"
                        else
                            echo "APP_KEY já existe no arquivo .env"
                        fi
                    '''
                }
            }
        }
        stage('Build and Run Docker') {
            steps {
                script {
                    sh '''
                        echo "🐳 Parando containers existentes..."
                        docker compose down
                        
                        echo "🔨 Buildando e iniciando containers..."
                        echo "📝 O frontend será buildado automaticamente dentro do container"
                        docker compose up -d --build
                        
                        echo "⏳ Aguardando containers iniciarem e frontend ser buildado..."
                        echo "⏰ Aguardando 90 segundos para o build completo..."
                        sleep 90
                        
                        echo "🔍 Verificando status dos containers..."
                        docker compose ps
                        
                        echo "📋 Verificando se o frontend foi buildado dentro do container..."
                        if docker exec app-base test -d /var/www/frontend/build && docker exec app-base test -f /var/www/frontend/build/index.html; then
                            echo "✅ Frontend buildado com sucesso dentro do container!"
                            echo "📁 Arquivos no build:"
                            docker exec app-base ls -la /var/www/frontend/build/
                            
                            echo "📋 Copiando build do container para o host..."
                            docker cp app-base:/var/www/frontend/build ./frontend/
                            echo "✅ Build copiado para o host!"
                            
                            echo "🔄 Reiniciando container do Nginx para carregar o novo build..."
                            docker compose restart nginx
                            sleep 10
                        else
                            echo "❌ Frontend não foi buildado corretamente no container"
                            echo "📋 Logs do container:"
                            docker compose logs app
                            echo "📁 Verificando diretório frontend no container:"
                            docker exec app-base ls -la /var/www/frontend/
                            exit 1
                        fi
                    '''
                }
            }
        }
        stage('Health Check') {
            steps {
                script {
                    sh '''
                        echo "🏥 Verificando se a aplicação está respondendo..."
                        
                        # Aguarda um pouco mais para garantir que tudo está funcionando
                        sleep 15
                        
                        # Testa o health check
                        if curl -f http://192.168.250.195/health; then
                            echo "✅ Aplicação está funcionando corretamente!"
                        else
                            echo "❌ Aplicação não está respondendo"
                            exit 1
                        fi
                        
                        # Testa se o frontend está acessível
                        if curl -f http://192.168.250.195/; then
                            echo "✅ Frontend está acessível!"
                        else
                            echo "❌ Frontend não está acessível"
                            echo "📋 Verificando logs do Nginx:"
                            docker compose logs nginx
                            exit 1
                        fi
                    '''
                }
            }
        }
    }
    post {
        always {
            script {
                sh '''
                    echo "=== Status final dos containers ==="
                    docker compose ps
                    
                    echo "=== Logs dos containers ==="
                    docker compose logs --tail=50
                '''
            }
        }
        success {
            echo "✅ Deploy realizado com sucesso!"
            echo "🌐 Frontend: http://192.168.250.195"
            echo "🔌 API: http://192.168.250.195/api"
        }
        failure {
            echo "❌ Deploy falhou!"
        }
    }
}
